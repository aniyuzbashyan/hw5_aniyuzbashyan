#include <stdio.h>
#include <stdlib.h>

int main()
{
    int n;
    int sum = 0;

    printf("Enter the number of elements: ");
    scanf("%d", &n);

    int *arr = calloc(n, sizeof(int));

    printf("Array after calloc: ");

    for (int i = 0; i < n; i++) {
        printf("%d ", arr[i]);
    }

    printf("\nEnter %d integers: ", n);

    for (int i = 0; i < n; i++) {
        scanf("%d", &arr[i]);
        sum += arr[i];
    }

    printf("Updated array: ");

    for (int i = 0; i < n; i++) {
        printf("%d ", arr[i]);
    }

    float average = (float)sum / n;

    printf("\nAverage of the array: %.1f\n", average);

    return 0;
}
